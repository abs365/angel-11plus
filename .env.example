# ============================================================
# Angel 11+ — Development Environment Variables
#
# For LOCAL development:
#   Copy this file to .env.local and fill in the values.
#   .env.local is gitignored and will never be committed.
#
# For CLOUD development (GitHub Codespaces):
#   Do NOT create .env.local in a Codespace.
#   Set secrets in:
#   GitHub → Repository → Settings → Secrets and variables
#   → Codespaces → New repository secret
#   They are injected automatically on Codespace startup.
#
# The app works fully without any of these variables.
# Progress is stored in localStorage only until Supabase
# is configured. AI writing feedback returns a 503 when
# OPENAI_API_KEY is absent — no crash.
# ============================================================


# -------- Supabase (optional — enables cloud sync) --------
# https://app.supabase.com → Project → Settings → API
#
# Project URL — must start with https://
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
#
# Anon / public key — safe to expose client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -------- OpenAI (optional — enables AI writing feedback) --------
# https://platform.openai.com/api-keys
# Server-only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-...


# -------- App URL (optional — affects OG metadata only) --------
# Set to http://localhost:3000 for local dev.
# Leave unset in Codespaces (defaults to https://angel11plus.com
# which is fine for OG metadata in development).
# NEXT_PUBLIC_APP_URL=http://localhost:3000
